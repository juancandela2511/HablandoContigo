# ============================================================================
# DOCKERFILE FRONTEND - HABLANDO CONTIGO
# Contexto de build: ./frontend
# ============================================================================

# Etapa 1: Compilación de Frontend con Node 22 y Vite
FROM node:22-alpine AS build-stage
WORKDIR /app

# Definición de URL de API para el bundle estático de producción
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

COPY package*.json ./
RUN npm install

COPY . .

# Asegurar permisos de ejecución en los binarios de node_modules/.bin (vite, vue-tsc, run-p)
RUN chmod -R +x node_modules/.bin

RUN npm run build

# Etapa 2: Servidor Web Nginx de Alto Rendimiento y Proxy SPA
FROM nginx:alpine AS production-stage
COPY --from=build-stage /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
