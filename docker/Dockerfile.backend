# ============================================================================
# DOCKERFILE BACKEND - HABLANDO CONTIGO
# Contexto de build: ./backend
# ============================================================================

FROM node:22-alpine
WORKDIR /app

# Copia de dependencias e instalación limpia en contenedor Linux
COPY package*.json ./
RUN npm install

# Copia del código fuente (excluyendo node_modules por .dockerignore)
COPY . .

# Asegurar permisos de ejecución en los binarios de node_modules/.bin (tsc, tsx, etc.)
RUN chmod -R +x node_modules/.bin

# Compilación de TypeScript a JavaScript
RUN npm run build

EXPOSE 3000

ENV PORT=3000
ENV NODE_ENV=production

CMD ["npm", "start"]
