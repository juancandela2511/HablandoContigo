# ============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — HABLANDO CONTIGO
# Copia este archivo como .env y ajusta los valores para tu entorno.
# ============================================================================

# Servidor Express Backend
PORT=3000
FRONTEND_URL=http://localhost:8085
NODE_ENV=development
CORS_ORIGIN=http://localhost:8085,http://localhost:5173

# Parámetros de Base de Datos PostgreSQL
POSTGRES_DB=mi_base_datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_seguro_aqui
POSTGRES_PORT=5433

# Conexión directa utilizada por Node.js local
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=tu_password_seguro_aqui
DB_NAME=mi_base_datos

# Configuración de Inteligencia Artificial (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Seguridad JWT — Genera una cadena aleatoria larga y segura
JWT_SECRET=tu_clave_secreta_jwt_para_firmar_tokens
JWT_EXPIRES_IN=7d
