# ============================================================================
# PLANTILLA DE ENTORNO BACKEND (server/.env.example)
# ============================================================================

# Servidor Express
PORT=3000
FRONTEND_URL=http://localhost:5173

# Seguridad y Autenticación JWT
JWT_SECRET=tu_secreto_jwt_super_seguro
JWT_EXPIRES_IN=7d

# Conexión a Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña_postgres
DB_NAME=mi_base_datos

# Pool de PostgreSQL
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# Configuración de Inteligencia Artificial (Ollama)
# - Desarrollo local fuera de Docker: http://localhost:11434
# - Backend dentro de red Docker: http://ollama:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
